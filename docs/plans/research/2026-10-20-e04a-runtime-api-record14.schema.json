            "COMPLETE_INLINE_FUNCTIONS",
            "COMPLETE_MACRO_DEFINITION_AND_USAGE_CONTRACT",
            "COMPLETE_MACRO_DEFINITION_BRANCHES",
            "COMPLETE_MEMBER_FUNCTION",
            "COMPLETE_NESTED_TYPES_AND_FUNCTIONS_WITH_BRANCH_BINDING",
