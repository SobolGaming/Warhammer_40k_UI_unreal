            "MACRO_BRANCH_BINDING_SLICE",
            "MACRO_DEFAULT_BINDING",
            "MACRO_SPECIALIZATION_BINDING_SLICE",
            "MEMBER_STORAGE_BINDING_SLICE",
            "NAMESPACE_BINDING_WITH_COMPLETE_FUNCTION",
