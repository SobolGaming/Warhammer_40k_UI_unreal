            "CLASS_INHERITANCE_AND_KEY_FUNCTION_BINDING_SLICE",
            "CLASS_INHERITANCE_BINDING_SLICE",
            "COMPLETE_API_CONTRACT_COMMENT",
            "COMPLETE_CLASS_API_DECLARATION_WITH_INLINE_MEMBERS",
            "COMPLETE_CLASS_API_DECLARATIONS_AND_INLINE_MEMBERS",
