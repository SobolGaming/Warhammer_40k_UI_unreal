{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROPOSED record14 complete runtime lookup API source metadata",
  "description": "Structural proposal only. FULL_RECORD means all metadata fields recursively; it grants no source BODY read or execution. Cross-record candidate/ownership/unit/line/hash joins require separate root derivation and unresolved values must be refused before review allocation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordKind",
    "recordOrdinal",
    "proposalState",
    "bindingStatus",
    "candidateBinding",
    "accessSelection",
    "engine",
    "provenance",
    "inventory",
