        },
        "supplementId": {
          "type": [
            "string",
            "null"
          ]
        },
        "unitId": {
          "pattern": "^APIUNIT-P[0-9]{2,}-[0-9]{3,}$",
          "type": "string"
        },
        "physicalRange": {
          "minItems": 2,
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "type": "array",
